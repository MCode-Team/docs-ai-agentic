EXPORT_PUBLIC_DIR=public/exports

# Database Settings
POSTGRES_HOST=postgres
POSTGRES_DB=agentic
POSTGRES_USER=agentic
POSTGRES_PORT=5432
POSTGRES_PASSWORD=xxxx
# Database URL
DATABASE_URL=postgres://agentic:xxxxxx@localhost:5432/agentic

# LLM Settings
OPENAI_API_KEY="sk-xxxx"
ANTHROPIC_API_KEY="sk-xxxxxx"  # For Claude models
GOOGLE_API_KEY="xxxxx"  # For Gemini models (e.g., gemini-3-pro-preview)

# Internal cron/runner security
# Used by docker-compose maintenance-runner to call internal endpoint.
CRON_SECRET="replace-with-a-long-random-string"

# Memory maintenance (event-driven)
MEMORY_MAINTENANCE_DELAY_MIN=10
MAINTENANCE_INTERVAL_SECONDS=60
MAINTENANCE_BATCH_LIMIT=5
MAINTENANCE_DAYS=3

# ถ้าต้องการเปิดใช้งาน Cohere Reranking (Optional แต่แนะนำ)
COHERE_API_KEY="xxxxx"
ZERANK_URL=http://zerank:80  # สำหรับ Docker internal network
HUGGING_FACE_HUB_TOKEN="hf_xxxxx"